{
  "title": "仿真运行记录",
  "description": "任务流动态时序仿真的运行记录：场景、结果（瓶颈/风险/时序）、耗时",
  "fields": [
    {
      "name": "software_id",
      "type": "string",
      "title": "软件ID",
      "description": "关联 softwares.id"
    },
    {
      "name": "model_id",
      "type": "string",
      "title": "模型ID",
      "description": "关联 taskflow_models.id"
    },
    {
      "name": "scenario",
      "type": "text",
      "title": "仿真场景",
      "description": "如：峰值并发、单节点故障、资源受限"
    },
    {
      "name": "result",
      "type": "text",
      "title": "仿真结果",
      "description": "瓶颈任务、时序风险、最长链路等结论"
    },
    {
      "name": "duration_ms",
      "type": "int",
      "title": "运行耗时(ms)"
    },
    {
      "name": "status",
      "type": "string",
      "title": "状态",
      "default": "\"已完成\"",
      "enum": [
        "待运行",
        "运行中",
        "已完成",
        "失败"
      ]
    },
    {
      "name": "ran_at",
      "type": "time",
      "title": "运行时间"
    }
  ],
  "indexes": [
    {
      "fields": [
        "software_id"
      ]
    }
  ]
}
