{
  "title": "版本基线",
  "description": "需求基线快照：规模、追踪覆盖率、符合性总分",
  "fields": [
    {
      "name": "code",
      "type": "string",
      "title": "基线编号",
      "description": "形如 BL-V3.3",
      "required": true
    },
    {
      "name": "req_count",
      "type": "int",
      "title": "需求数",
      "default": 0
    },
    {
      "name": "coverage",
      "type": "number",
      "title": "追踪覆盖率 %"
    },
    {
      "name": "score",
      "type": "number",
      "title": "符合性总分"
    },
    {
      "name": "status",
      "type": "string",
      "title": "状态",
      "default": "\"已归档\""
    },
    {
      "name": "released_at",
      "type": "time",
      "title": "发布时间"
    },
    {
      "name": "project_code",
      "type": "string",
      "title": "项目码",
      "description": "所属项目码"
    },
    {
      "name": "commit",
      "type": "string",
      "title": "commit",
      "description": "基线绑定的 commit"
    }
  ],
  "indexes": [
    {
      "fields": [
        "code"
      ],
      "unique": true
    }
  ],
  "max_records_per_user": 0
}
