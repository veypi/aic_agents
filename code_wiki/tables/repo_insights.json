      "default": "architecture",
      "enum": [
        "architecture",
        "dependency",
        "pattern",
        "api",
        "data_flow",
        "overview",
        "tech_stack",
        "other"
      ]
    },
    {
      "name": "title",
      "type": "string",
      "title": "标题",
      "description": "洞察标题",
      "required": true
    },
    {
      "name": "content",
      "type": "text",
      "title": "内容",
      "description": "Markdown 格式的详细分析内容",
      "required": true
    },
    {
      "name": "confidence",
      "type": "string",
      "title": "置信度",
      "description": "AI 对此洞察的置信度",
      "default": "medium",
      "enum": [
